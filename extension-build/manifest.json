{
  "manifest_version": 3,
  "name": "Gemini SAT PDF Exporter",
  "version": "1.0.0",
  "description": "Extract SAT problems and explanations from Google Gemini interface and export to PDF",
  "permissions": ["scripting", "webNavigation"],
  "host_permissions": ["https://gemini.google.com/*"],
  "background": { "service_worker": "background.js" },
  "web_accessible_resources": [
    { "resources": ["styles.css"], "matches": ["https://gemini.google.com/*"] }
  ]
}
